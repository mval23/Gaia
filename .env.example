# Copy to .env.local for local development. On Vercel, add the same names under
# Project -> Settings -> Environment Variables.

# Gaia accounts and cloud saving (Supabase -> Project Settings -> API).
# Leave empty to run Gaia without sign-in, saving in the browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Microsoft sign-in for the Outlook calendar link.
VITE_MS_CLIENT_ID=
VITE_MS_TENANT_ID=

# Optional: phone notifications (needs the Supabase values above, and Vercel).
# Make a key pair once with: npx web-push generate-vapid-keys
# The public key is safe in the app; the other three stay on the server only.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase -> Project Settings -> API Keys -> the secret (service_role) key.
SUPABASE_SECRET_KEY=
# Any long random string; supabase/reminders.sql sends it with every call.
CRON_SECRET=
