# Copy to .env.local for local development. On Vercel, add the same names under
# Project -> Settings -> Environment Variables.

# Gaia accounts and cloud saving (Supabase -> Project Settings -> API).
# Leave empty to run Gaia without sign-in, saving in the browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Microsoft sign-in for the Outlook calendar link.
VITE_MS_CLIENT_ID=
VITE_MS_TENANT_ID=
